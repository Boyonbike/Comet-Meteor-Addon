{
  "schemaVersion": 1,
  "id": "comet",
  "version": "${version}",
  "name": "Comet",
  "authors": [
    "Boyonabike"
  ],
  "description": "Comet: adaptive elytra flight, DEVILS Auto Wasp, TNT coating, Chat Tools, storage ESP, Speedmine, waypoints and HUD elements for Meteor Client.",
  "contact": {
    "homepage": "https://github.com/Boyonbike/Comet-Meteor-Addon",
    "sources": "https://github.com/Boyonbike/Comet-Meteor-Addon",
    "issues": "https://github.com/Boyonbike/Comet-Meteor-Addon/issues"
  },
  "environment": "client",
  "license": "GPL-3.0-only",
  "entrypoints": {
    "meteor": [
      "dev.tntcoating.TntCoatingAddon"
    ]
  },
  "custom": {
    "meteor-client:color": "225,80,55"
  },
  "depends": {
    "java": ">=${jdk_version}",
    "minecraft": "${minecraft_version}",
    "fabricloader": ">=0.19.3",
    "meteor-client": ">=1.21.11-82"
  },
  "suggests": {
    "xaerominimap": "*",
    "xaeroworldmap": "*",
    "baritone-meteor": "*"
  },
  "mixins": [
    "comet.mixins.json"
  ]
}
